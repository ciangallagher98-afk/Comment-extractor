{
  "manifest_version": 3,
  "name": "Comment Extractor",
  "version": "0.1.0",
  "description": "Collects a post and its comments from TikTok and Instagram and sends them to Comment Extractor for analysis.",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Comment Extractor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*", "https://www.instagram.com/*"],
      "js": ["catcher.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tiktok.com/*", "https://www.instagram.com/*"],
      "js": ["config.js", "platforms.js", "collector.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://comment-extractor-nine.vercel.app/*"],
      "js": ["config.js", "bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
